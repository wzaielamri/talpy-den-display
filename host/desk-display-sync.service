# sync.py as a systemd user service: it starts with your login, starts again if it stops, and logs to
# the journal. It runs host/sync.py through a link in ~/.local/bin, so the clone can live anywhere.
# From the clone's folder:
#
#   mkdir -p ~/.local/bin ~/.config/systemd/user
#   ln -sf "$PWD/host/sync.py" ~/.local/bin/desk-display-sync
#   printf 'DESK_LAT=\nDESK_LON=\n' > ~/.config/desk-display.env    # then put in your latitude and longitude
#   cp host/desk-display-sync.service ~/.config/systemd/user/
#   systemctl --user daemon-reload
#   systemctl --user enable --now desk-display-sync
#   journalctl --user -u desk-display-sync -f            # what it sends and what the board says
#
# Without the udev rule (70-desk-display.rules), add DESK_PORT=/dev/ttyUSB0 to that env file.
# sync.py reads that file too when you run it by hand, so the place is the same either way.
# Flashing the board needs its port: systemctl --user stop desk-display-sync, pio run -t upload, start.
[Unit]
Description=Desk display: coding-agent jobs, plan usage, time and weather over USB serial

[Service]
Environment=DESK_PORT=/dev/desk-display
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-%h/.config/desk-display.env
ExecStart=/usr/bin/env python3 %h/.local/bin/desk-display-sync
Restart=always
RestartSec=5

[Install]
WantedBy=default.target
